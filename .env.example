# ─────────────────────────────────────────────────────────────────────────────
# ShowPulser Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Notifiers enabled (comma-separated: telegram, fast2sms, whatsapp)
ENABLED_NOTIFIERS=telegram,fast2sms,whatsapp

# ── 1. Telegram (Notifies for ALL theatres) ──────────────────────────────────
# Create bot via @BotFather on Telegram to get Token
TELEGRAM_BOT_TOKEN=
# Get your Chat ID via @userinfobot or @raw_data_bot on Telegram
TELEGRAM_CHAT_ID=

# ── 2. WhatsApp (via Green API – Free QR code based) ─────────────────────────
# Get Instance ID & API Token from https://console.green-api.com/
GREENAPI_INSTANCE_ID=
GREENAPI_API_TOKEN=
# Phone number with country code (e.g. 919876543210 or 9876543210)
GREENAPI_RECIPIENT=
GREENAPI_API_URL=https://api.green-api.com
# Optional: Specific theatre filter (leave blank to notify for ALL theatres)
GREENAPI_SPECIFIC_THEATRES=

# ── 3. Fast2SMS (SMS & Automated Voice Call for SPECIFIC theatres) ────────────
# Dev API key from https://www.fast2sms.com/dashboard/dev-api
FAST2SMS_API_KEY=

# 10-digit mobile number(s) to receive SMS and Voice Call alerts (e.g. 9876543210)
FAST2SMS_NUMBERS=9893524768,9792695075

# Specific theatre keywords (comma-separated, case-insensitive).
# Example: Sathyam, Palazzo, PVR, Luxe, Escape
# Only updates matching these theatres will trigger Fast2SMS SMS & Voice Calls.
# Leave blank or set to * to trigger for all theatres.
FAST2SMS_SPECIFIC_THEATRES=Seven Screen, Raakki, Raaki

# Enable/disable SMS or Call separately
FAST2SMS_ENABLE_SMS=true
FAST2SMS_ENABLE_CALL=true

# Fast2SMS SMS Route: "q" (Quick SMS) or "dlt" / "otp"
FAST2SMS_ROUTE=q

# Fast2SMS Voice File ID: Required for automated outbound voice call (OBD).
# Upload an audio recording at https://www.fast2sms.com/dashboard/voice/files to get file_id
FAST2SMS_VOICE_FILE_ID=

# ── App & Scheduler Settings ────────────────────────────────────────────────
# Check every 5 minutes (300 seconds)
SCAN_INTERVAL_SECONDS=300

# Only notify when a new theatre comes or opens booking (true/false)
NOTIFY_ONLY_NEW_THEATRES=true

# Render Keep-Alive Activator: Render public URL (e.g. https://your-app.onrender.com)
# Pings itself every 3 minutes so Render free tier never sleeps after 15 minutes!
KEEP_ALIVE_URL=

LOG_LEVEL=INFO
DATABASE_PATH=data/showpulser.db
